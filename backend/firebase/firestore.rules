rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow Firebase Functions to access all documents
    match /{document=**} {
      allow read, write: if request.auth != null && 
        (request.auth.token.firebase.sign_in_provider == 'google.com' || 
         request.auth.token.firebase.sign_in_provider == 'custom');
    }
    
    // Users can read and write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Codes are one-time use and should be readable by anyone with the code
    // but only writable by authenticated users
    match /codes/{codeId} {
      allow read: if true; // Anyone can read codes (needed for verification)
      allow write: if request.auth != null; // Only authenticated users can create codes
    }
  }
} 